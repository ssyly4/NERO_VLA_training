+def repair_lerobot_episode_subset_index(dataset) -> None:
+    """Repair non-contiguous episode lookup in the bundled LeRobot v2.1 loader."""
+    if dataset.episodes is None:
+        return
+    starts = torch.zeros(dataset.meta.total_episodes, dtype=torch.long)
+    ends = torch.zeros(dataset.meta.total_episodes, dtype=torch.long)
+    cursor = 0
+    for episode in dataset.episodes:
+        length = int(dataset.meta.episodes[episode]["length"])
+        starts[episode] = cursor
+        cursor += length
+        ends[episode] = cursor
+    if cursor != len(dataset.hf_dataset):
+        raise RuntimeError(f"LeRobot subset index length mismatch: {cursor} != {len(dataset.hf_dataset)}")
+    dataset.episode_data_index = {"from": starts, "to": ends}
+
