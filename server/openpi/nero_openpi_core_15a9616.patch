index 0000000..e23b587
--- /dev/null
+++ b/src/openpi/models/rtc.py
@@ -0,0 +1,90 @@
+"""Real-Time Chunking guidance for flow-matching action policies.
+
+This is the JAX counterpart of LeRobot's RTCProcessor. It constrains the
+prefix of a newly sampled action chunk toward the unexecuted tail of the
+previous chunk while leaving the suffix free to react to the latest image.
+"""
+
+from collections.abc import Callable
+
+import jax
+import jax.numpy as jnp
+
+
+def linear_prefix_weights(
+    inference_delay: int | jax.Array,
+    execution_horizon: int | jax.Array,
+    total_steps: int,
+    *,
+    dtype: jnp.dtype = jnp.float32,
+) -> jax.Array:
+    """Build the official RTC linear prefix-attention schedule."""
+    indices = jnp.arange(total_steps)
+    start = jnp.clip(jnp.asarray(inference_delay), 0, total_steps)
+    end = jnp.clip(jnp.asarray(execution_horizon), start, total_steps)
+    denominator = jnp.maximum(end - start + 1, 1)
+    ramp = (end - indices) / denominator
+    weights = jnp.where(indices < start, 1.0, jnp.where(indices < end, ramp, 0.0))
+    return weights.astype(dtype)
+
+
+def guided_velocity(
+    denoise_velocity: Callable[[jax.Array], jax.Array],
+    x_t: jax.Array,
+    prev_chunk_left_over: jax.Array,
+    *,
+    inference_delay: int | jax.Array,
+    execution_horizon: int | jax.Array,
+    time: float | jax.Array,
+    max_guidance_weight: float = 10.0,
+) -> jax.Array:
+    """Apply RTC prefix guidance to one flow-matching denoising step."""
+    if prev_chunk_left_over.ndim != x_t.ndim:
+        raise ValueError(
+            "RTC previous chunk must have the same rank as the action latent: "
+            f"previous={prev_chunk_left_over.shape} latent={x_t.shape}"
+        )
+    if (
+        prev_chunk_left_over.shape[0] != x_t.shape[0]
+        or prev_chunk_left_over.shape[1] > x_t.shape[1]
+        or prev_chunk_left_over.shape[2] > x_t.shape[2]
+    ):
+        raise ValueError(
+            "RTC previous chunk does not fit the action latent: "
+            f"previous={prev_chunk_left_over.shape} latent={x_t.shape}"
+        )
+    if prev_chunk_left_over.shape != x_t.shape:
+        padded_previous = jnp.zeros_like(x_t)
+        prev_chunk_left_over = padded_previous.at[
+            :, : prev_chunk_left_over.shape[1], : prev_chunk_left_over.shape[2]
+        ].set(prev_chunk_left_over)
+
+    time_value = jnp.asarray(time, dtype=x_t.dtype)
+
+    def endpoint(input_x_t: jax.Array) -> jax.Array:
+        return input_x_t - time_value * denoise_velocity(input_x_t)
+
+    x1_t, endpoint_pullback = jax.vjp(endpoint, x_t)
+    weights = linear_prefix_weights(
+        inference_delay,
+        execution_horizon,
+        x_t.shape[1],
+        dtype=x_t.dtype,
+    )[None, :, None]
+    error = (prev_chunk_left_over - x1_t) * weights
+    correction = endpoint_pullback(error)[0]
+
+    tau = 1.0 - time_value
+    squared_one_minus_tau = (1.0 - tau) ** 2
+    inv_r2 = (squared_one_minus_tau + tau**2) / squared_one_minus_tau
+    coefficient = (1.0 - tau) / tau
+    guidance_weight = jnp.nan_to_num(
+        coefficient * inv_r2,
+        nan=0.0,
+        posinf=max_guidance_weight,
+        neginf=0.0,
+    )
+    guidance_weight = jnp.minimum(guidance_weight, max_guidance_weight)
+
+    base_velocity = (x_t - x1_t) / time_value
+    return base_velocity - guidance_weight * correction
